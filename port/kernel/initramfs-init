#!/bin/sh
# Hi3798Mv100 boot initramfs: rescue window, then switch_root to root= (eMMC).
PATH=/usr/sbin:/usr/bin:/sbin:/bin
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
exec 0</dev/console 1>/dev/console 2>&1   # initramfs has no /dev/console node -> init starts without stdio

rescue() {
	echo; echo "*** RESCUE SHELL *** ($1)"
	echo "    uboot-prompt -r   : reboot to U-Boot fastboot# prompt"
	echo "    exit              : continue normal boot"
	mkdir -p /dev/pts; mount -t devpts devpts /dev/pts 2>/dev/null
	setsid sh -c 'exec sh -l </dev/ttyAMA0 >/dev/ttyAMA0 2>&1'
}

root=; rootflags=rw; rootwait=20
for a in $(cat /proc/cmdline); do
	case $a in
		root=*) root=${a#root=} ;;
		rescue) rescue "rescue on cmdline" ;;
	esac
done

printf '\nPress any key within 3s for rescue shell... '
if read -t 3 -n 1 _k < /dev/ttyAMA0; then
	rescue "key pressed"
fi
echo

[ -n "$root" ] || { rescue "no root= on cmdline"; }
i=0
while [ ! -b "$root" ] && [ $i -lt $((rootwait * 10)) ]; do sleep 0.1; i=$((i + 1)); done
[ -b "$root" ] || rescue "root device $root not found"

mkdir -p /newroot
until mount -t ext4 -o rw "$root" /newroot; do
	rescue "mounting $root failed (fix it, then exit to retry)"
done
until [ -x /newroot/sbin/init ]; do
	rescue "/newroot/sbin/init missing"
done

umount /sys /proc
mount --move /dev /newroot/dev
exec switch_root /newroot /sbin/init
