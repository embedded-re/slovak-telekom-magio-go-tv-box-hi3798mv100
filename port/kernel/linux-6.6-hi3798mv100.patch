diff --git a/arch/arm/mach-hisi/platsmp.c b/arch/arm/mach-hisi/platsmp.c
index 9ce93e0b6..dbd6f0015 100644
--- a/arch/arm/mach-hisi/platsmp.c
+++ b/arch/arm/mach-hisi/platsmp.c
@@ -10,6 +10,7 @@
 #include <linux/delay.h>
 
 #include <asm/cacheflush.h>
+#include <asm/cp15.h>
 #include <asm/smp_plat.h>
 #include <asm/smp_scu.h>
 #include <asm/mach/map.h>
@@ -182,6 +183,127 @@ static const struct smp_operations hip01_smp_ops __initconst = {
 	.smp_boot_secondary     = hip01_boot_secondary,
 };
 
+/*
+ * Hi3798MV100: secondaries reset to 0xffff0000 (on-chip RAM). Their resets live
+ * in PERI_CRG20 (CRG 0xf8a22000 + 0x50): ARM_POR_SRST bit 12+cpu, ARM_SRST
+ * bit 16+cpu, CLUSTER_DBG_SRST bit 20+cpu. The vendor kernel (HiSTB SDK
+ * mach-hi3798mx/platsmp.c) drops the CPU clock to 400 MHz via CRG + 0x48
+ * (CPU_LP, bit 10 = switch begin) while releasing them.
+ */
+#define HI3798MV100_CPU_LP		0x00
+#define HI3798MV100_CPU_LP_SW_BEGIN	BIT(10)
+#define HI3798MV100_CPU_RST		0x08
+#define HI3798MV100_ARM_POR_SRST(c)	BIT(12 + (c))
+#define HI3798MV100_ARM_SRST(c)		BIT(16 + (c))
+#define HI3798MV100_DBG_SRST(c)		BIT(20 + (c))
+
+static void __iomem *hi3798mv100_cpuctrl;
+
+/*
+ * CPU clock cap. U-Boot leaves the CPU at 1.2 GHz (CPU_LP sel 5). Without the
+ * vendor's temperature-control/DVFS thread, sustained 4-core load at 1.2 GHz
+ * silently hard-hangs this box after 2.5-7 min (thermal; worse with more
+ * voltage). 800 MHz (sel 1) passed a 20 min full-load soak. The DT property
+ * "hisilicon,cpu-clk-sel" on the cpuctrl node selects the mux input:
+ * 0 APLL, 1 800 MHz, 3 1.5 GHz, 4 24 MHz, 5 1.2 GHz, 6 400 MHz, 7 600 MHz.
+ * Switch sequence as in U-Boot: write sel|0x300, then sel|0x700.
+ */
+static void __init hi3798mv100_cpu_clk_cap(struct device_node *np)
+{
+	void __iomem *lp = hi3798mv100_cpuctrl + HI3798MV100_CPU_LP;
+	u32 sel, old;
+
+	if (of_property_read_u32(np, "hisilicon,cpu-clk-sel", &sel) || sel > 7)
+		return;
+	old = readl_relaxed(lp);
+	if ((old & 0x7) == sel)
+		return;
+	writel_relaxed(0x300 | sel, lp);
+	writel_relaxed(0x700 | sel, lp);
+	pr_info("hi3798mv100: CPU clock select %u -> %u\n", old & 0x7, sel);
+}
+
+static void __init hi3798mv100_smp_prepare_cpus(unsigned int max_cpus)
+{
+	struct device_node *np;
+
+	np = of_find_compatible_node(NULL, NULL, "hisilicon,hi3798mv100-cpuctrl");
+	if (!np) {
+		pr_err("hi3798mv100: no cpuctrl node, SMP disabled\n");
+		return;
+	}
+	hi3798mv100_cpuctrl = of_iomap(np, 0);
+	if (hi3798mv100_cpuctrl)
+		hi3798mv100_cpu_clk_cap(np);
+	else
+		pr_err("hi3798mv100: failed to map cpuctrl\n");
+	of_node_put(np);
+}
+
+static void hi3798mv100_cpu_reset(unsigned int cpu, bool release)
+{
+	void __iomem *rst = hi3798mv100_cpuctrl + HI3798MV100_CPU_RST;
+	static const u32 order_rel[] = { 0, 2, 1 };	/* POR, DBG, ARM */
+	u32 bits[3] = { HI3798MV100_ARM_POR_SRST(cpu), HI3798MV100_ARM_SRST(cpu),
+			HI3798MV100_DBG_SRST(cpu) };
+	int i;
+
+	for (i = 0; i < 3; i++) {
+		u32 b = release ? bits[order_rel[i]] : bits[order_rel[2 - i]];
+		u32 v = readl_relaxed(rst);
+
+		writel_relaxed(release ? v & ~b : v | b, rst);
+	}
+}
+
+static int hi3798mv100_boot_secondary(unsigned int cpu, struct task_struct *idle)
+{
+	if (!hi3798mv100_cpuctrl)
+		return -ENODEV;
+
+	hix5hd2_set_scu_boot_addr(HIX5HD2_BOOT_ADDRESS,
+				  __pa_symbol(secondary_startup));
+	/* make the trampoline visible to the core coming out of reset */
+	flush_cache_all();
+
+	/*
+	 * The vendor kernel drops the CPU clock to 400 MHz (CPU_LP 0x306/0x706)
+	 * around this; doing so here breaks hisi-femac RX (300+ ms latency,
+	 * drops) until the next reset, so the cores are released at full speed.
+	 */
+	hi3798mv100_cpu_reset(cpu_logical_map(cpu), true);
+
+	arch_send_wakeup_ipi_mask(cpumask_of(cpu));
+	return 0;
+}
+
+#ifdef CONFIG_HOTPLUG_CPU
+static void hi3798mv100_cpu_die(unsigned int cpu)
+{
+	/* leave coherency; cpu_kill() on another CPU then asserts our resets */
+	v7_exit_coherency_flush(louis);
+	while (1)
+		wfi();
+}
+
+static int hi3798mv100_cpu_kill(unsigned int cpu)
+{
+	msleep(10);	/* let the dying CPU reach WFI */
+	hi3798mv100_cpu_reset(cpu_logical_map(cpu), false);
+	return 1;
+}
+#endif
+
+static const struct smp_operations hi3798mv100_smp_ops __initconst = {
+	.smp_prepare_cpus	= hi3798mv100_smp_prepare_cpus,
+	.smp_boot_secondary	= hi3798mv100_boot_secondary,
+#ifdef CONFIG_HOTPLUG_CPU
+	.cpu_die		= hi3798mv100_cpu_die,
+	.cpu_kill		= hi3798mv100_cpu_kill,
+#endif
+};
+
 CPU_METHOD_OF_DECLARE(hi3xxx_smp, "hisilicon,hi3620-smp", &hi3xxx_smp_ops);
 CPU_METHOD_OF_DECLARE(hix5hd2_smp, "hisilicon,hix5hd2-smp", &hix5hd2_smp_ops);
 CPU_METHOD_OF_DECLARE(hip01_smp, "hisilicon,hip01-smp", &hip01_smp_ops);
+CPU_METHOD_OF_DECLARE(hi3798mv100_smp, "hisilicon,hi3798mv100-smp", &hi3798mv100_smp_ops);
