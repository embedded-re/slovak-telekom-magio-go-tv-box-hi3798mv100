diff --git a/arch/arm/boot/dts/hisilicon/hi3798mv100.dtsi b/arch/arm/boot/dts/hisilicon/hi3798mv100.dtsi
new file mode 100644
index 000000000..d60c0872a
--- /dev/null
+++ b/arch/arm/boot/dts/hisilicon/hi3798mv100.dtsi
@@ -0,0 +1,525 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * HiSilicon Hi3798Mv100 SoC device tree source
+ *
+ * Based on reverse engineering from vendor kernel 3.10.0_s40
+ * Machine: "bigfish" (HiSTBAndroidV600R001C00SPC062)
+ */
+
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+#include <dt-bindings/thermal/thermal.h>
+#include <dt-bindings/clock/histb-clock.h>
+
+/ {
+	#address-cells = <1>;
+	#size-cells = <1>;
+
+	interrupt-parent = <&gic>;
+
+	cpus {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		cpu0: cpu@0 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a7";
+			reg = <0x0>;
+			enable-method = "hisilicon,hi3798mv100-smp";
+			#cooling-cells = <2>;
+		};
+
+		cpu@1 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a7";
+			reg = <0x1>;
+			enable-method = "hisilicon,hi3798mv100-smp";
+		};
+
+		cpu@2 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a7";
+			reg = <0x2>;
+			enable-method = "hisilicon,hi3798mv100-smp";
+		};
+
+		cpu@3 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a7";
+			reg = <0x3>;
+			enable-method = "hisilicon,hi3798mv100-smp";
+		};
+	};
+
+	/*
+	 * Verified from U-Boot (b31): GICD_IIDR=0x0100143b, TYPER=0xfc65 (192 IRQs, 4 CPUs),
+	 * ITARGETSR=0x01010101; GICC_IIDR=0x0102143b. Old 0x10301000 was plain DRAM.
+	 */
+	gic: interrupt-controller@f8a01000 {
+		compatible = "arm,cortex-a7-gic";
+		#interrupt-cells = <3>;
+		#address-cells = <0>;
+		interrupt-controller;
+		reg = <0xf8a01000 0x1000>, <0xf8a02000 0x2000>;
+	};
+
+	timer {
+		compatible = "arm,armv7-timer";
+		/* CNTVCT reads garbage; vendor kernel uses SP804 instead */
+		status = "disabled";
+		interrupts = <GIC_PPI 13 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_LOW)>,
+			     <GIC_PPI 14 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_LOW)>,
+			     <GIC_PPI 11 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_LOW)>,
+			     <GIC_PPI 10 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_LOW)>;
+		clock-frequency = <24000000>;
+	};
+
+	pmu {
+		compatible = "arm,cortex-a7-pmu";
+		/* IRQ unknown (old value was TDE's line) */
+		status = "disabled";
+	};
+
+	clk_24m: clk_24m {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <24000000>;
+	};
+
+	clk_25m: clk_25m {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <25000000>;
+	};
+
+	clk_50m: clk_50m {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <50000000>;
+	};
+
+	clk_100m: clk_100m {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <100000000>;
+	};
+
+	clk_200m: clk_200m {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <200000000>;
+	};
+
+	clk_125m: clk_125m {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <125000000>;
+	};
+
+	clk_uart0: clk_uart0 {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		/* Actual UART0 hardware clock ~83.3 MHz (measured via IBRD=45 FBRD=12 at 115200) */
+		clock-frequency = <83289600>;
+	};
+
+	clk_timer: clk_timer {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <24000000>;
+	};
+
+	/*
+	 * CPU clock switch (CRG+0x48) and per-core resets (CRG+0x50) used by the
+	 * hi3798mv100 SMP ops; secondaries enter via a trampoline at 0xffff0000.
+	 */
+	cpuctrl: cpu-controller@f8a22048 {
+		compatible = "hisilicon,hi3798mv100-cpuctrl";
+		reg = <0xf8a22048 0x10>;
+		/* boot at 800 MHz; hi3798mv100-cpufreq then switches 800/1200 MHz under thermal control */
+		hisilicon,cpu-clk-sel = <1>;
+	};
+
+	/* T-sensor (PMC10/12/13), decoded from the stock kernel's mpu_get_temperature */
+	tsensor: thermal-sensor@f8a23028 {
+		compatible = "hisilicon,hi3798mv100-tsensor";
+		reg = <0xf8a23028 0x10>;
+		#thermal-sensor-cells = <0>;
+	};
+
+	/*
+	 * Stock cooling at 1.2 GHz x4: 84 C after 5 min, memory-heavy load hangs ~90 C.
+	 * 800 MHz holds. Throttle to 800 MHz at 75 C, orderly shutdown at 95 C.
+	 */
+	thermal-zones {
+		cpu_thermal: cpu-thermal {
+			polling-delay-passive = <1000>;
+			polling-delay = <2000>;
+			thermal-sensors = <&tsensor>;
+
+			trips {
+				cpu_alert: cpu-alert {
+					temperature = <75000>;
+					hysteresis = <5000>;
+					type = "passive";
+				};
+				cpu_crit: cpu-crit {
+					temperature = <95000>;
+					hysteresis = <2000>;
+					type = "critical";
+				};
+			};
+
+			cooling-maps {
+				map0 {
+					trip = <&cpu_alert>;
+					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+				};
+				map1 {
+					trip = <&cpu_alert>;
+					cooling-device = <&mali THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+				};
+			};
+		};
+	};
+
+	/* System controller; SC_SYSRES at +0x4 (write 0xdeadbeef = reset), as on Hi3798CV200 */
+	sysctrl: system-controller@f8000000 {
+		compatible = "syscon";
+		reg = <0xf8000000 0x1000>;
+	};
+
+	reboot {
+		compatible = "syscon-reboot";
+		regmap = <&sysctrl>;
+		offset = <0x4>;
+		value = <0xdeadbeef>;
+	};
+
+	soc {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		compatible = "simple-bus";
+		ranges;
+
+		uart0_clk: uart0_clk {
+			compatible = "fixed-clock";
+			#clock-cells = <0>;
+			clock-frequency = <24000000>;
+		};
+
+		uart0: serial@f8b00000 {
+			compatible = "arm,pl011", "arm,primecell";
+			reg = <0xf8b00000 0x1000>;
+			arm,primecell-periphid = <0x00041011>;
+			interrupts = <GIC_SPI 49 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&clk_uart0>, <&clk_100m>;
+			clock-names = "uartclk", "apb_pclk";
+			reg-io-width = <4>;
+			status = "disabled";
+		};
+
+		uart1: serial@f8006000 {
+			compatible = "arm,pl011", "arm,primecell";
+			reg = <0xf8006000 0x1000>;
+			arm,primecell-periphid = <0x00041011>;
+			interrupts = <GIC_SPI 50 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&clk_24m>, <&clk_100m>;
+			clock-names = "uartclk", "apb_pclk";
+			status = "disabled";
+		};
+
+		uart2: serial@f8b02000 {
+			compatible = "arm,pl011", "arm,primecell";
+			reg = <0xf8b02000 0x1000>;
+			arm,primecell-periphid = <0x00041011>;
+			interrupts = <GIC_SPI 51 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&clk_uart0>, <&clk_100m>;
+			clock-names = "uartclk", "apb_pclk";
+			status = "disabled";
+		};
+
+		/*
+		 * eMMC = hi_mci.1 @ f9830000, GIC 67 (SPI 35) -- confirmed by vendor /proc/interrupts.
+		 * CRG 0xa0 (PERI_CRG40) = 0x00040103 set by U-Boot: clk_sel[9:8]=01 -> ciu 100 MHz
+		 * (fastboot SDIO1_CLK_SEL_100M, MMC_CLK 100000000), drive phase [18:16]=180 deg,
+		 * sample phase [14:12]=0 deg -- same values the stock kernel uses for DDR52.
+		 * Before b44 the ciu was wrongly described as 50 MHz, so every card clock was 2x the
+		 * requested one (the b31 "HS 50 MHz" CRC errors were really 100 MHz).
+		 */
+		mmc0: mmc@f9830000 {
+			compatible = "snps,dw-mshc";
+			reg = <0xf9830000 0x1000>;
+			interrupts = <GIC_SPI 35 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&clk_100m>, <&clk_100m>;
+			clock-names = "biu", "ciu";
+			fifo-depth = <256>;
+			max-frequency = <50000000>;
+			cap-mmc-highspeed;
+			mmc-ddr-3_3v;
+			bus-width = <8>;
+			non-removable;
+			disable-wp;
+			status = "disabled";
+		};
+
+		/* SD slot = hi_mci.0 @ f9820000, GIC 66 (SPI 34). CRG 0x9c = 0x203, mux[9:8]=2 -> ciu 50 MHz.
+		 * Native CDETECT works (vendor himciv200 uses it); I/O LDO 0xf8a2011c left as U-Boot set it. */
+		mmc1: mmc@f9820000 {
+			compatible = "snps,dw-mshc";
+			reg = <0xf9820000 0x1000>;
+			interrupts = <GIC_SPI 34 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&clk_100m>, <&clk_50m>;
+			clock-names = "biu", "ciu";
+			fifo-depth = <256>;
+			bus-width = <4>;
+			max-frequency = <50000000>;
+			cap-sd-highspeed;
+			disable-wp;
+			post-power-on-delay-ms = <200>; /* vendor himciv200 waits 100 ms after PWREN */
+			status = "disabled";
+		};
+
+		/*
+		 * hieth-sf (SDK "hieth", sfv300) @ f9840000 = same IP as mainline hisi-femac:
+		 * up-port regs @ +0x0000, MDIO @ +0x1100, GLB @ +0x1300 (down port @ +0x2000 unused).
+		 * Vendor IRQ GIC 103 -> SPI 71. Internal FE PHY (FESTA) at MDIO addr 1; U-Boot
+		 * initialises PHY clock/reset/address/fixups on every boot (CRG 0xf8a22000 + 0x388).
+		 */
+		mdio0: mdio@f9841100 {
+			compatible = "hisilicon,hisi-femac-mdio";
+			reg = <0xf9841100 0x10>;
+			clocks = <&clk_50m>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			status = "disabled";
+
+			fephy: ethernet-phy@1 {
+				reg = <1>;
+			};
+		};
+
+		femac: ethernet@f9840000 {
+			compatible = "hisilicon,hisi-femac-v1";
+			reg = <0xf9840000 0x1000>, <0xf9841300 0x200>;
+			interrupts = <GIC_SPI 71 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&clk_50m>;
+			phy-handle = <&fephy>;
+			phy-mode = "mii";
+			status = "disabled";
+		};
+
+		/*
+		 * USB2 host PHYs: not memory mapped. Clock/reset in CRG (f8a22000 +0xb8/0xbc,
+		 * +0x190/0x198), INNO PHY test bus in PERI_CTRL (f8a20000 +0x124/+0x158).
+		 * U-Boot "usb stop" leaves all of it in reset. Cell 0 = host0, 1 = host1.
+		 */
+		usb2_phy: usb-phy@f8a22000 {
+			compatible = "hisilicon,hi3798mv100-usb2-host-phy";
+			reg = <0xf8a22000 0x1000>, <0xf8a20000 0x1000>;
+			#phy-cells = <1>;
+		};
+
+		ehci0: usb@f9890000 {
+			compatible = "generic-ehci";
+			reg = <0xf9890000 0x10000>;
+			interrupts = <GIC_SPI 66 IRQ_TYPE_LEVEL_HIGH>;
+			phys = <&usb2_phy 0>;
+			phy-names = "usb";
+			status = "disabled";
+		};
+
+		ohci0: usb@f9880000 {
+			compatible = "generic-ohci";
+			reg = <0xf9880000 0x10000>;
+			interrupts = <GIC_SPI 67 IRQ_TYPE_LEVEL_HIGH>;
+			phys = <&usb2_phy 0>;
+			phy-names = "usb";
+			status = "disabled";
+		};
+
+		ehci1: usb@f9930000 {
+			compatible = "generic-ehci";
+			reg = <0xf9930000 0x10000>;
+			interrupts = <GIC_SPI 62 IRQ_TYPE_LEVEL_HIGH>;
+			phys = <&usb2_phy 1>;
+			phy-names = "usb";
+			status = "disabled";
+		};
+
+		ohci1: usb@f9920000 {
+			compatible = "generic-ohci";
+			reg = <0xf9920000 0x10000>;
+			interrupts = <GIC_SPI 63 IRQ_TYPE_LEVEL_HIGH>;
+			phys = <&usb2_phy 1>;
+			phy-names = "usb";
+			status = "disabled";
+		};
+
+		/*
+		 * USB3: DWC3 core run as plain xHCI (stock kernel: hiusb-xhci, io f98a0000, GIC 101).
+		 * Glue replays the vendor clk-hiusb3.c sequence (CRG44 +0xb0, CRG101 +0x194, PERI_CTRL).
+		 */
+		usb3: usb3-glue@f98a0000 {
+			compatible = "hisilicon,hi3798mv100-usb3";
+			reg = <0xf98a0000 0x10000>, <0xf8a22000 0x1000>, <0xf8a20000 0x1000>;
+			#address-cells = <1>;
+			#size-cells = <1>;
+			ranges;
+			status = "disabled";
+
+			xhci: usb@f98a0000 {
+				compatible = "generic-xhci";
+				reg = <0xf98a0000 0x10000>;
+				interrupts = <GIC_SPI 69 IRQ_TYPE_LEVEL_HIGH>;
+			};
+		};
+
+		usb_otg: usb@f98c0000 {
+			compatible = "snps,dwc2";
+			reg = <0xf98c0000 0x40000>;
+			interrupts = <GIC_SPI 68 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&clk_100m>;
+			clock-names = "otg";
+			dr_mode = "otg";
+			g-np-tx-fifo-size = <16>;
+			g-rx-fifo-size = <256>;
+			g-tx-fifo-size = <128 128 64>;
+			status = "disabled";
+		};
+
+
+
+		/*
+		 * Mali-450 MP2 (GP + 2 PP, PMU, broadcast), all IRQs on GIC 126 = SPI 94 (vendor
+		 * mali4xx platform). Glue enables CRG53 (+0xd4) clocks, pulses the GPU reset, runs the
+		 * vendor PMC setup and fixes the core clock (default 345.6 MHz, no devfreq: switching
+		 * the clock while a job runs hangs the GPU until reboot).
+		 */
+		gpu_glue: gpu-glue@f8a22000 {
+			compatible = "hisilicon,hi3798mv100-gpu-glue";
+			reg = <0xf8a22000 0x1000>, <0xf8a23000 0x1000>;
+			#clock-cells = <0>;
+			#address-cells = <1>;
+			#size-cells = <1>;
+			ranges;
+			status = "disabled";
+
+			mali: gpu@f9200000 {
+				compatible = "hisilicon,hi3798mv100-mali", "arm,mali-450";
+				reg = <0xf9200000 0x30000>;
+				interrupts = <GIC_SPI 94 IRQ_TYPE_LEVEL_HIGH>,
+					     <GIC_SPI 94 IRQ_TYPE_LEVEL_HIGH>,
+					     <GIC_SPI 94 IRQ_TYPE_LEVEL_HIGH>,
+					     <GIC_SPI 94 IRQ_TYPE_LEVEL_HIGH>,
+					     <GIC_SPI 94 IRQ_TYPE_LEVEL_HIGH>,
+					     <GIC_SPI 94 IRQ_TYPE_LEVEL_HIGH>,
+					     <GIC_SPI 94 IRQ_TYPE_LEVEL_HIGH>,
+					     <GIC_SPI 94 IRQ_TYPE_LEVEL_HIGH>;
+				interrupt-names = "gp", "gpmmu", "pp0", "ppmmu0", "pp1", "ppmmu1", "pp", "pmu";
+				clocks = <&clk_200m>, <&gpu_glue>;
+				clock-names = "bus", "core";
+				operating-points-v2 = <&gpu_opp_table>;
+				#cooling-cells = <2>;
+			};
+		};
+
+		gpu_opp_table: opp-table-gpu {
+			compatible = "operating-points-v2";
+
+			opp-200000000 { opp-hz = /bits/ 64 <200000000>; };
+			opp-250000000 { opp-hz = /bits/ 64 <250000000>; };
+			opp-300000000 { opp-hz = /bits/ 64 <300000000>; };
+			opp-345600000 { opp-hz = /bits/ 64 <345600000>; };
+			opp-375000000 { opp-hz = /bits/ 64 <375000000>; };
+			opp-400000000 { opp-hz = /bits/ 64 <400000000>; };
+			opp-432000000 { opp-hz = /bits/ 64 <432000000>; };
+		};
+
+		i2c0: i2c@f8b10000 {
+			#address-cells = <1>;
+			#size-cells = <0>;
+			compatible = "snps,designware-i2c";
+			reg = <0xf8b10000 0x1000>;
+			interrupts = <GIC_SPI 38 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&clk_100m>;
+			clock-names = "pclk";
+			status = "disabled";
+		};
+
+		i2c1: i2c@f8b11000 {
+			#address-cells = <1>;
+			#size-cells = <0>;
+			compatible = "snps,designware-i2c";
+			reg = <0xf8b11000 0x1000>;
+			interrupts = <GIC_SPI 39 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&clk_100m>;
+			clock-names = "pclk";
+			status = "disabled";
+		};
+
+		i2c2: i2c@f8b12000 {
+			#address-cells = <1>;
+			#size-cells = <0>;
+			compatible = "snps,designware-i2c";
+			reg = <0xf8b12000 0x1000>;
+			interrupts = <GIC_SPI 40 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&clk_100m>;
+			clock-names = "pclk";
+			status = "disabled";
+		};
+
+		/*
+		 * IR receiver (vendor SDK DTS ir@f8001000, GIC 79). Clock gate/reset in
+		 * SC_CLKGATE_SRST_CTRL (SC+0x48) bit 4 en / bit 5 rst, 24 MHz (vendor clk-hiir.c);
+		 * ir-hix5hd2 drives that via the sysctrl regmap (socdata clk_reg 0x48).
+		 */
+		ir: ir@f8001000 {
+			compatible = "hisilicon,hix5hd2-ir";
+			reg = <0xf8001000 0x1000>;
+			interrupts = <GIC_SPI 47 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&clk_24m>;
+			hisilicon,power-syscon = <&sysctrl>;
+			status = "disabled";
+		};
+
+		/*
+		 * TRNG (vendor SDK msp/drv/cipher, MV100 = old layout: CTRL +0, NUMBER +4,
+		 * STAT +8 count[2:0]); no clock gate. Same IP/address as Hi3798CV200.
+		 */
+		rng: rng@f8005000 {
+			compatible = "hisilicon,histb-rng";
+			reg = <0xf8005000 0x100>;
+		};
+
+		/*
+		 * SP805 watchdog (vendor WDG0). Verified: a second expiry hard-resets the
+		 * SoC (back to Fastboot). PrimeCell ID regs read 0. WDG1 @ f8a2d000 unused.
+		 */
+		watchdog: watchdog@f8a2c000 {
+			compatible = "arm,sp805", "arm,primecell";
+			arm,primecell-periphid = <0x00141805>;
+			reg = <0xf8a2c000 0x1000>;
+			clocks = <&clk_24m>, <&clk_24m>;
+			clock-names = "wdog_clk", "apb_pclk";
+			timeout-sec = <30>;
+		};
+
+		/*
+		 * SP804 timers as used by the vendor kernel: timer2 (f8a29000) is the
+		 * clocksource, timer4..7 are per-CPU local timers with one SPI each
+		 * (vendor GIC 58/91/59/92). 24 MHz. PrimeCell ID regs read 0.
+		 */
+		timer: timer@f8a29000 {
+			compatible = "hisilicon,hi3798mv100-timer";
+			reg = <0xf8a29000 0x20>,
+			      <0xf8a2a000 0x20>, <0xf8a2a020 0x20>,
+			      <0xf8a2b000 0x20>, <0xf8a2b020 0x20>;
+			interrupts = <GIC_SPI 26 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 59 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 27 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 60 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&clk_timer>;
+		};
+
+	};
+};
diff --git a/arch/arm/boot/dts/hisilicon/hi3798mv100-bigfish.dts b/arch/arm/boot/dts/hisilicon/hi3798mv100-bigfish.dts
new file mode 100644
index 000000000..27fdb5319
--- /dev/null
+++ b/arch/arm/boot/dts/hisilicon/hi3798mv100-bigfish.dts
@@ -0,0 +1,135 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * Device tree for Hi3798Mv100 "bigfish" reference board
+ *
+ * Board: bigfish (G6O110SVT / HiSTBAndroidV600R001C00SPC062)
+ * SoC:   HiSilicon Hi3798Mv100 (quad Cortex-A7 @ 1.2GHz)
+ * RAM:   1GB DDR3
+ * Boot:  U-Boot Fastboot 3.3.0, kernel loaded at 0x02000000
+ */
+
+/dts-v1/;
+
+#include "hi3798mv100.dtsi"
+
+/ {
+	model = "HiSilicon Hi3798Mv100 Bigfish Board";
+	compatible = "hisilicon,hi3798mv100", "hisilicon,hi3798mv100-bigfish";
+
+	aliases {
+		serial0 = &uart0;
+		serial1 = &uart1;
+		serial2 = &uart2;
+		mmc0 = &mmc0;
+		mmc1 = &mmc1;
+		ethernet0 = &femac;
+	};
+
+	chosen {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+		stdout-path = "serial0:115200n8";
+
+		/*
+		 * HDMI boot framebuffer set up by Fastboot (logo from the 'logo' partition, display
+		 * config from 'baseparam'): VDP HD graphics layer @ f8cc6800 scans out 0x3efd5000,
+		 * 1920x1080 ARGB8888, stride 0x1e0*16 = 7680 (read back from the live registers).
+		 */
+		framebuffer@3efd5000 {
+			compatible = "simple-framebuffer";
+			reg = <0x3efd5000 0x7e9000>;
+			width = <1920>;
+			height = <1080>;
+			stride = <7680>;
+			format = "a8r8g8b8";
+			memory-region = <&vdp_fastboot>;
+		};
+	};
+
+	memory@0 {
+		device_type = "memory";
+		reg = <0x00000000 0x40000000>;
+	};
+
+	reserved-memory {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		/*
+		 * Fastboot "Reserve Memory" area (0x3e357000..0x40000000): HD + SD graphics
+		 * framebuffers, VDP coefficient/parameter tables (VDP regs point at 0x3f7bf000..,
+		 * 0x3fd00000..), all still read by the display engine after handoff.
+		 */
+		vdp_fastboot: framebuffer@3e357000 {
+			reg = <0x3e357000 0x1ca9000>;
+			no-map;
+		};
+	};
+};
+
+&uart0 {
+	status = "okay";
+};
+
+&mmc0 {
+	status = "okay"; /* eMMC @ f9830000 (b30: was pointing at SD controller f9820000 with wrong IRQ) */
+};
+
+&gpu_glue {
+	status = "okay";
+};
+
+&usb3 {
+	status = "okay";
+};
+
+&mmc1 {
+	status = "okay";
+};
+
+&mdio0 {
+	status = "okay";
+};
+
+&femac {
+	status = "okay";
+	local-mac-address = [80 8c 97 42 50 34]; /* U-Boot env ethaddr */
+};
+
+&ehci0 {
+	status = "okay";
+};
+
+&ohci0 {
+	status = "okay";
+};
+
+&ehci1 {
+	status = "okay";
+};
+
+&ohci1 {
+	status = "okay";
+};
+
+&usb_otg {
+	status = "disabled"; /* GSNPSID reads 0x0 — controller absent or ungated on this board */
+};
+
+&i2c0 {
+	status = "disabled";
+};
+
+&i2c1 {
+	status = "disabled";
+};
+
+&i2c2 {
+	status = "disabled";
+};
+
+&ir {
+	status = "okay";
+};
diff --git a/drivers/phy/hisilicon/phy-hi3798mv100-usb2.c b/drivers/phy/hisilicon/phy-hi3798mv100-usb2.c
new file mode 100644
index 000000000..d86996643
--- /dev/null
+++ b/drivers/phy/hisilicon/phy-hi3798mv100-usb2.c
@@ -0,0 +1,344 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * HiSilicon Hi3798MV100 USB2 host PHY / controller clock+reset glue.
+ *
+ * The INNO USB2 PHYs on this SoC are not memory mapped: they are clocked and
+ * reset through PERI_CRG46/47 (host0, 2-port PHY) and PERI_CRG100/102 (host1,
+ * 1-port PHY), and their internal registers are written through a bit-banged
+ * test interface in PERI_CTRL (PERI_USB1 / PERI_USB14).  Sequence taken from
+ * the HiSTBLinuxV100R005 SDK (drivers/hisilicon/clk/hi3798mx/clk-hiusb2.c),
+ * chipid & 0xf0 != 0x10 branch (SC_SYSID0 = 0x37980100 on the tested board).
+ *
+ * U-Boot runs "usb stop" before handing over, which leaves everything in
+ * reset, so Linux must replay the full sequence.
+ *
+ * #phy-cells = <1>: 0 = host0 (EHCI0 f9890000 / OHCI0 f9880000),
+ *                   1 = host1 (EHCI1 f9930000 / OHCI1 f9920000).
+ */
+
+#include <linux/bits.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/phy/phy.h>
+#include <linux/platform_device.h>
+
+/* CRG (0xf8a22000) */
+#define PERI_CRG46_USB2CTRL	0x0b8
+#define PERI_CRG47_USB2PHY	0x0bc
+#define PERI_CRG100_USB2PHY2	0x190
+#define PERI_CRG102_USB2CTRL2	0x198
+
+/* PERI_CTRL (0xf8a20000) */
+#define PERI_USB0		0x120
+#define PERI_USB1		0x124
+#define PERI_USB13		0x154
+#define PERI_USB14		0x158
+
+/* PERI_CRG46 / PERI_CRG102 */
+#define USB2_BUS_CKEN		BIT(0)
+#define USB2_OHCI48M_CKEN	BIT(1)
+#define USB2_OHCI12M_CKEN	BIT(2)
+#define USB2_OTG_UTMI_CKEN	BIT(3)
+#define USB2_HST_PHY_CKEN	BIT(4)
+#define USB2_UTMI0_CKEN		BIT(5)
+#define USB2_UTMI1_CKEN		BIT(6)
+#define USB2_BUS_SRST_REQ	BIT(12)
+#define USB2_UTMI0_SRST_REQ	BIT(13)
+#define USB2_UTMI1_SRST_REQ	BIT(14)
+#define USB2_HST_PHY_SRST_REQ	BIT(16)
+#define USB2_OTG_PHY_SRST_REQ	BIT(17)
+
+#define HOST0_RESETS	(USB2_BUS_SRST_REQ | USB2_UTMI0_SRST_REQ | \
+			 USB2_UTMI1_SRST_REQ | USB2_HST_PHY_SRST_REQ | \
+			 USB2_OTG_PHY_SRST_REQ)
+#define HOST0_CLKS	(USB2_BUS_CKEN | USB2_OHCI48M_CKEN | USB2_OHCI12M_CKEN | \
+			 USB2_OTG_UTMI_CKEN | USB2_HST_PHY_CKEN | \
+			 USB2_UTMI0_CKEN | USB2_UTMI1_CKEN)
+/* host1 uses bit 14 for its only UTMI reset */
+#define HOST1_RESETS	(USB2_BUS_SRST_REQ | BIT(14) | USB2_HST_PHY_SRST_REQ)
+#define HOST1_CLKS	(USB2_BUS_CKEN | USB2_OHCI48M_CKEN | USB2_OHCI12M_CKEN | \
+			 USB2_HST_PHY_CKEN | USB2_UTMI0_CKEN)
+
+/* PERI_CRG47 */
+#define USB_PHY0_REF_CKEN	BIT(0)
+#define USB_PHY1_REF_CKEN	BIT(1)
+#define USB_PHY0_SRST_REQ	BIT(8)
+#define USB_PHY0_SRST_TREQ	BIT(9)
+#define USB_PHY1_SRST_REQ	BIT(10)
+#define USB_PHY1_SRST_TREQ	BIT(11)
+
+/* PERI_CRG100 */
+#define USB_PHY2_REF_CKEN	BIT(0)
+#define USB_PHY2_SRST_REQ	BIT(8)
+#define USB_PHY2_SRST_TREQ	BIT(9)
+
+/* PERI_USB0 / PERI_USB13 */
+#define WORDINTERFACE		BIT(0)
+#define ULPI_BYPASS_EN_PORT0	BIT(3)
+#define SS_BURST16_EN		BIT(9)
+
+/* PERI_USB1 / PERI_USB14 test interface: [7:0] data, [12:8] addr */
+#define TEST_WREN		BIT(13)
+#define TEST_CLK		BIT(14)
+#define TEST_RSTN		BIT(15)
+
+struct hi3798mv100_usb2 {
+	void __iomem *crg;
+	void __iomem *peri;
+	struct mutex lock;
+};
+
+struct hi3798mv100_usb2_port {
+	struct hi3798mv100_usb2 *priv;
+	unsigned int host;
+};
+
+static void rmw(void __iomem *reg, u32 clr, u32 set)
+{
+	writel((readl(reg) & ~clr) | set, reg);
+}
+
+/* Clock one byte into the PHY's test interface: addr/data are pre-encoded. */
+static void test_write(void __iomem *reg, u32 addr_data)
+{
+	u32 v = TEST_RSTN | TEST_WREN | addr_data;
+
+	writel(v, reg);
+	writel(v | TEST_CLK, reg);
+	writel(v, reg);
+}
+
+static void host0_init(struct hi3798mv100_usb2 *p)
+{
+	void __iomem *crg46 = p->crg + PERI_CRG46_USB2CTRL;
+	void __iomem *crg47 = p->crg + PERI_CRG47_USB2PHY;
+	void __iomem *tst = p->peri + PERI_USB1;
+
+	rmw(crg46, 0, HOST0_RESETS);
+	udelay(200);
+	rmw(crg47, 0, USB_PHY0_SRST_REQ | USB_PHY1_SRST_REQ |
+		      USB_PHY0_SRST_TREQ | USB_PHY1_SRST_TREQ);
+	udelay(200);
+
+	/* UTMI, 8-bit interface, no 16-beat bursts */
+	rmw(p->peri + PERI_USB0, WORDINTERFACE | SS_BURST16_EN,
+	    ULPI_BYPASS_EN_PORT0);
+	udelay(100);
+
+	rmw(crg47, 0, USB_PHY0_REF_CKEN | USB_PHY1_REF_CKEN);
+	udelay(300);
+
+	test_write(tst, 0x0809);	/* PLL core clock 240M */
+	udelay(300);
+
+	/* release PHY power-on reset */
+	rmw(crg47, USB_PHY0_SRST_REQ | USB_PHY1_SRST_REQ, 0);
+	udelay(300);
+
+	/* "avoid inno phy error" */
+	test_write(tst, 0x073b);
+	udelay(500);
+	test_write(tst, 0x0bc0);
+	udelay(500);
+	test_write(tst, 0x073f);
+	mdelay(1);
+	test_write(tst, 0x0be0);
+	mdelay(1);
+	/* 2-port PHY disconnect fix */
+	test_write(tst, 0x0a02);
+	test_write(tst, 0x1a1e);
+	udelay(500);
+	test_write(tst, 0x0801);	/* PLL core clock 480M */
+	udelay(300);
+
+	/* release port resets, let the comp circuit settle */
+	rmw(crg47, USB_PHY0_SRST_TREQ | USB_PHY1_SRST_TREQ, 0);
+	mdelay(2);
+
+	rmw(crg46, HOST0_RESETS, HOST0_CLKS);
+	udelay(200);
+}
+
+static void host0_exit(struct hi3798mv100_usb2 *p)
+{
+	rmw(p->crg + PERI_CRG47_USB2PHY, 0,
+	    USB_PHY0_SRST_REQ | USB_PHY1_SRST_REQ |
+	    USB_PHY0_SRST_TREQ | USB_PHY1_SRST_TREQ);
+	udelay(100);
+	rmw(p->crg + PERI_CRG46_USB2CTRL,
+	    USB2_BUS_CKEN | USB2_HST_PHY_CKEN | USB2_UTMI0_CKEN |
+	    USB2_UTMI1_CKEN, 0);
+	udelay(200);
+}
+
+static void host1_init(struct hi3798mv100_usb2 *p)
+{
+	void __iomem *crg100 = p->crg + PERI_CRG100_USB2PHY2;
+	void __iomem *crg102 = p->crg + PERI_CRG102_USB2CTRL2;
+	void __iomem *tst = p->peri + PERI_USB14;
+
+	rmw(crg102, 0, HOST1_RESETS);
+	udelay(200);
+	rmw(crg100, 0, USB_PHY2_SRST_REQ | USB_PHY2_SRST_TREQ);
+	udelay(200);
+
+	rmw(p->peri + PERI_USB13, WORDINTERFACE | SS_BURST16_EN,
+	    ULPI_BYPASS_EN_PORT0);
+	udelay(100);
+
+	rmw(crg100, 0, USB_PHY2_REF_CKEN);
+	udelay(300);
+
+	test_write(tst, 0x0809);	/* PLL core clock 240M */
+	udelay(300);
+
+	rmw(crg100, USB_PHY2_SRST_REQ, 0);
+	mdelay(2);
+
+	test_write(tst, 0x0801);	/* PLL core clock 480M */
+	udelay(300);
+
+	/* config clk output */
+	writel(TEST_RSTN | TEST_WREN | 0x060c, tst);
+	udelay(500);
+	writel(TEST_RSTN | TEST_WREN | TEST_CLK | 0x060c, tst);
+	udelay(500);
+	writel(TEST_RSTN | TEST_WREN | 0x060c, tst);
+	mdelay(10);
+
+	/* 1-port PHY disconnect fix */
+	test_write(tst, 0x0a02);
+	udelay(500);
+
+	rmw(crg100, USB_PHY2_SRST_TREQ, 0);
+	mdelay(2);
+
+	rmw(crg102, HOST1_RESETS, HOST1_CLKS);
+	udelay(200);
+}
+
+static void host1_exit(struct hi3798mv100_usb2 *p)
+{
+	rmw(p->crg + PERI_CRG102_USB2CTRL2, 0, HOST1_RESETS);
+	udelay(200);
+	rmw(p->crg + PERI_CRG100_USB2PHY2, 0,
+	    USB_PHY2_SRST_REQ | USB_PHY2_SRST_TREQ);
+	udelay(100);
+}
+
+static int hi3798mv100_usb2_init(struct phy *phy)
+{
+	struct hi3798mv100_usb2_port *port = phy_get_drvdata(phy);
+
+	mutex_lock(&port->priv->lock);
+	if (port->host == 0)
+		host0_init(port->priv);
+	else
+		host1_init(port->priv);
+	mutex_unlock(&port->priv->lock);
+
+	return 0;
+}
+
+static int hi3798mv100_usb2_exit(struct phy *phy)
+{
+	struct hi3798mv100_usb2_port *port = phy_get_drvdata(phy);
+
+	mutex_lock(&port->priv->lock);
+	if (port->host == 0)
+		host0_exit(port->priv);
+	else
+		host1_exit(port->priv);
+	mutex_unlock(&port->priv->lock);
+
+	return 0;
+}
+
+static const struct phy_ops hi3798mv100_usb2_ops = {
+	.init	= hi3798mv100_usb2_init,
+	.exit	= hi3798mv100_usb2_exit,
+	.owner	= THIS_MODULE,
+};
+
+static struct phy *hi3798mv100_usb2_xlate(struct device *dev,
+					  struct of_phandle_args *args)
+{
+	struct phy **phys = dev_get_drvdata(dev);
+
+	if (args->args_count != 1 || args->args[0] > 1)
+		return ERR_PTR(-EINVAL);
+
+	return phys[args->args[0]];
+}
+
+static int hi3798mv100_usb2_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct hi3798mv100_usb2 *priv;
+	struct phy_provider *provider;
+	struct phy **phys;
+	struct resource *res;
+	unsigned int i;
+
+	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
+	phys = devm_kcalloc(dev, 2, sizeof(*phys), GFP_KERNEL);
+	if (!priv || !phys)
+		return -ENOMEM;
+	mutex_init(&priv->lock);
+
+	/*
+	 * CRG and PERI_CTRL are shared with other (future) drivers: map
+	 * without claiming the regions.
+	 */
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!res)
+		return -EINVAL;
+	priv->crg = devm_ioremap(dev, res->start, resource_size(res));
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 1);
+	if (!res)
+		return -EINVAL;
+	priv->peri = devm_ioremap(dev, res->start, resource_size(res));
+	if (!priv->crg || !priv->peri)
+		return -ENOMEM;
+
+	for (i = 0; i < 2; i++) {
+		struct hi3798mv100_usb2_port *port;
+
+		port = devm_kzalloc(dev, sizeof(*port), GFP_KERNEL);
+		if (!port)
+			return -ENOMEM;
+		port->priv = priv;
+		port->host = i;
+
+		phys[i] = devm_phy_create(dev, NULL, &hi3798mv100_usb2_ops);
+		if (IS_ERR(phys[i]))
+			return PTR_ERR(phys[i]);
+		phy_set_drvdata(phys[i], port);
+	}
+
+	dev_set_drvdata(dev, phys);
+	provider = devm_of_phy_provider_register(dev, hi3798mv100_usb2_xlate);
+
+	return PTR_ERR_OR_ZERO(provider);
+}
+
+static const struct of_device_id hi3798mv100_usb2_of_match[] = {
+	{ .compatible = "hisilicon,hi3798mv100-usb2-host-phy" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, hi3798mv100_usb2_of_match);
+
+static struct platform_driver hi3798mv100_usb2_driver = {
+	.probe	= hi3798mv100_usb2_probe,
+	.driver	= {
+		.name		= "hi3798mv100-usb2-phy",
+		.of_match_table	= hi3798mv100_usb2_of_match,
+	},
+};
+module_platform_driver(hi3798mv100_usb2_driver);
+
+MODULE_DESCRIPTION("HiSilicon Hi3798MV100 USB2 host PHY");
+MODULE_LICENSE("GPL");
diff --git a/drivers/clocksource/timer-hi3798mv100.c b/drivers/clocksource/timer-hi3798mv100.c
new file mode 100644
index 000000000..01e0147fd
--- /dev/null
+++ b/drivers/clocksource/timer-hi3798mv100.c
@@ -0,0 +1,235 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * HiSilicon Hi3798MV100 timers.
+ *
+ * The SoC has four dual-channel SP804 blocks but no usable ARM generic timer
+ * (CNTVCT reads garbage) and no per-CPU private timer, so the vendor kernel
+ * (HiSTB SDK "hisilicon,timer") uses:
+ *   - timer2 (0xf8a29000) as free-running clocksource / sched_clock,
+ *   - one SP804 channel per CPU as local clock_event_device, each with its
+ *     own SPI that is routed to that CPU only:
+ *       cpu0 timer4 f8a2a000 SPI 26, cpu1 timer5 f8a2a020 SPI 59,
+ *       cpu2 timer6 f8a2b000 SPI 27, cpu3 timer7 f8a2b020 SPI 60.
+ *
+ * DT: reg = <clocksource>, <local0>..<localN-1>; interrupts = <local0>..;
+ *     clocks = <24 MHz timer clock>.
+ */
+
+#define pr_fmt(fmt) "hi3798mv100-timer: " fmt
+
+#include <linux/clk.h>
+#include <linux/clockchips.h>
+#include <linux/clocksource.h>
+#include <linux/cpu.h>
+#include <linux/cpuhotplug.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/irq.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/of_irq.h>
+#include <linux/percpu.h>
+#include <linux/sched_clock.h>
+#include <linux/slab.h>
+
+#include <asm/delay.h>
+
+/* SP804 channel registers */
+#define TIMER_LOAD		0x00
+#define TIMER_VALUE		0x04
+#define TIMER_CTRL		0x08
+#define  TIMER_CTRL_ONESHOT	BIT(0)
+#define  TIMER_CTRL_32BIT	BIT(1)
+#define  TIMER_CTRL_IE		BIT(5)
+#define  TIMER_CTRL_PERIODIC	BIT(6)
+#define  TIMER_CTRL_ENABLE	BIT(7)
+#define TIMER_INTCLR		0x0c
+#define TIMER_BGLOAD		0x18
+
+#define HI3798_MAX_CPUS		4
+
+struct hi3798_local_timer {
+	struct clock_event_device evt;
+	void __iomem *base;
+	unsigned long reload;
+	int irq;
+	char name[16];
+};
+
+static struct hi3798_local_timer hi3798_timers[HI3798_MAX_CPUS];
+static unsigned int hi3798_nr_local;
+static unsigned long hi3798_rate;
+static void __iomem *hi3798_cs_base;
+
+static inline struct hi3798_local_timer *to_lt(struct clock_event_device *evt)
+{
+	return container_of(evt, struct hi3798_local_timer, evt);
+}
+
+static void lt_disable(struct hi3798_local_timer *lt)
+{
+	writel_relaxed(0, lt->base + TIMER_CTRL);
+	writel_relaxed(1, lt->base + TIMER_INTCLR);
+}
+
+static int lt_shutdown(struct clock_event_device *evt)
+{
+	lt_disable(to_lt(evt));
+	return 0;
+}
+
+static int lt_set_periodic(struct clock_event_device *evt)
+{
+	struct hi3798_local_timer *lt = to_lt(evt);
+
+	lt_disable(lt);
+	writel_relaxed(lt->reload, lt->base + TIMER_LOAD);
+	writel_relaxed(TIMER_CTRL_32BIT | TIMER_CTRL_IE | TIMER_CTRL_PERIODIC |
+		       TIMER_CTRL_ENABLE, lt->base + TIMER_CTRL);
+	return 0;
+}
+
+static int lt_set_next_event(unsigned long next, struct clock_event_device *evt)
+{
+	struct hi3798_local_timer *lt = to_lt(evt);
+
+	writel_relaxed(0, lt->base + TIMER_CTRL);
+	writel_relaxed(next, lt->base + TIMER_LOAD);
+	writel_relaxed(TIMER_CTRL_32BIT | TIMER_CTRL_IE | TIMER_CTRL_ONESHOT |
+		       TIMER_CTRL_ENABLE, lt->base + TIMER_CTRL);
+	return 0;
+}
+
+static irqreturn_t lt_interrupt(int irq, void *dev_id)
+{
+	struct hi3798_local_timer *lt = dev_id;
+
+	writel_relaxed(1, lt->base + TIMER_INTCLR);
+	lt->evt.event_handler(&lt->evt);
+	return IRQ_HANDLED;
+}
+
+static int hi3798_timer_starting_cpu(unsigned int cpu)
+{
+	struct hi3798_local_timer *lt;
+
+	if (cpu >= hi3798_nr_local)
+		return 0;
+	lt = &hi3798_timers[cpu];
+
+	lt_disable(lt);
+	irq_force_affinity(lt->irq, cpumask_of(cpu));
+	enable_irq(lt->irq);
+
+	lt->evt.cpumask = cpumask_of(cpu);
+	clockevents_config_and_register(&lt->evt, hi3798_rate, 0xf, 0xffffffff);
+	return 0;
+}
+
+static int hi3798_timer_dying_cpu(unsigned int cpu)
+{
+	struct hi3798_local_timer *lt;
+
+	if (cpu >= hi3798_nr_local)
+		return 0;
+	lt = &hi3798_timers[cpu];
+
+	lt_disable(lt);
+	disable_irq_nosync(lt->irq);
+	return 0;
+}
+
+static u64 notrace hi3798_sched_read(void)
+{
+	return ~readl_relaxed(hi3798_cs_base + TIMER_VALUE);
+}
+
+/* udelay() from the 24 MHz counter: independent of the CPU clock (which we change) */
+static unsigned long hi3798_delay_read(void)
+{
+	return ~readl_relaxed(hi3798_cs_base + TIMER_VALUE);
+}
+
+static struct delay_timer hi3798_delay_timer = {
+	.read_current_timer = hi3798_delay_read,
+};
+
+static int __init hi3798_timer_init(struct device_node *np)
+{
+	struct clk *clk;
+	unsigned int i;
+	int ret;
+
+	clk = of_clk_get(np, 0);
+	if (IS_ERR(clk)) {
+		pr_err("no clock\n");
+		return PTR_ERR(clk);
+	}
+	ret = clk_prepare_enable(clk);
+	if (ret)
+		return ret;
+	hi3798_rate = clk_get_rate(clk);
+	if (!hi3798_rate)
+		return -EINVAL;
+
+	/* clocksource: free-running down-counter */
+	hi3798_cs_base = of_iomap(np, 0);
+	if (!hi3798_cs_base)
+		return -ENXIO;
+	writel_relaxed(0, hi3798_cs_base + TIMER_CTRL);
+	writel_relaxed(0xffffffff, hi3798_cs_base + TIMER_LOAD);
+	writel_relaxed(0xffffffff, hi3798_cs_base + TIMER_VALUE);
+	writel_relaxed(TIMER_CTRL_32BIT | TIMER_CTRL_ENABLE | TIMER_CTRL_PERIODIC,
+		       hi3798_cs_base + TIMER_CTRL);
+	clocksource_mmio_init(hi3798_cs_base + TIMER_VALUE, "hi3798-timer",
+			      hi3798_rate, 300, 32, clocksource_mmio_readl_down);
+	sched_clock_register(hi3798_sched_read, 32, hi3798_rate);
+	hi3798_delay_timer.freq = hi3798_rate;
+	register_current_timer_delay(&hi3798_delay_timer);
+
+	/* local timers */
+	for (i = 0; i < HI3798_MAX_CPUS && i < num_possible_cpus(); i++) {
+		struct hi3798_local_timer *lt = &hi3798_timers[i];
+
+		lt->base = of_iomap(np, i + 1);
+		lt->irq = irq_of_parse_and_map(np, i);
+		if (!lt->base || !lt->irq) {
+			pr_err("local timer %u: missing reg/irq\n", i);
+			return -EINVAL;
+		}
+		lt_disable(lt);
+		lt->reload = DIV_ROUND_CLOSEST(hi3798_rate, HZ);
+
+		snprintf(lt->name, sizeof(lt->name), "local_timer%u", i);
+		lt->evt.name = lt->name;
+		lt->evt.features = CLOCK_EVT_FEAT_PERIODIC | CLOCK_EVT_FEAT_ONESHOT;
+		lt->evt.rating = 350;
+		lt->evt.irq = lt->irq;
+		lt->evt.set_state_shutdown = lt_shutdown;
+		lt->evt.set_state_oneshot_stopped = lt_shutdown;
+		lt->evt.set_state_periodic = lt_set_periodic;
+		lt->evt.set_next_event = lt_set_next_event;
+		lt->evt.tick_resume = lt_shutdown;
+
+		irq_set_status_flags(lt->irq, IRQ_NOAUTOEN);
+		ret = request_irq(lt->irq, lt_interrupt,
+				  IRQF_TIMER | IRQF_NOBALANCING, lt->name, lt);
+		if (ret) {
+			pr_err("local timer %u: request_irq %d failed\n", i, lt->irq);
+			return ret;
+		}
+		hi3798_nr_local = i + 1;
+	}
+
+	ret = cpuhp_setup_state(CPUHP_AP_HI3798_TIMER_STARTING,
+				"clockevents/hi3798mv100:starting",
+				hi3798_timer_starting_cpu,
+				hi3798_timer_dying_cpu);
+	if (ret)
+		return ret;
+
+	pr_info("clocksource + %u local timers @ %lu Hz\n", hi3798_nr_local,
+		hi3798_rate);
+	return 0;
+}
+TIMER_OF_DECLARE(hi3798mv100, "hisilicon,hi3798mv100-timer", hi3798_timer_init);
diff --git a/drivers/thermal/hi3798mv100_thermal.c b/drivers/thermal/hi3798mv100_thermal.c
new file mode 100644
index 000000000..11154d678
--- /dev/null
+++ b/drivers/thermal/hi3798mv100_thermal.c
@@ -0,0 +1,76 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Hi3798MV100 on-die temperature sensor.
+ *
+ * Decoded from the stock 3.10 kernel (mpu_get_temperature): writing
+ * 0x07200000 to PMC10 starts continuous sampling, PMC12/PMC13 hold the last
+ * eight 8-bit samples, T[degC] = avg * 180 / 255 - 40.
+ */
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/thermal.h>
+
+#include "thermal_hwmon.h"
+
+#define TSENSOR_CTRL		0x0	/* PMC10 */
+#define TSENSOR_VAL0		0x8	/* PMC12 */
+#define TSENSOR_VAL1		0xc	/* PMC13 */
+#define TSENSOR_ENABLE		0x07200000
+
+static int hi3798mv100_tsensor_get_temp(struct thermal_zone_device *tz, int *temp)
+{
+	void __iomem *base = thermal_zone_device_priv(tz);
+	u32 v[2] = { readl_relaxed(base + TSENSOR_VAL0), readl_relaxed(base + TSENSOR_VAL1) };
+	u32 sum = 0;
+	int i;
+
+	for (i = 0; i < 4; i++)
+		sum += ((v[0] >> (8 * i)) & 0xff) + ((v[1] >> (8 * i)) & 0xff);
+
+	/* sum of 8 samples: T = sum/8 * 180/255 - 40 (millidegrees) */
+	*temp = (int)(sum * 180000U / (255U * 8U)) - 40000;
+	return 0;
+}
+
+static const struct thermal_zone_device_ops hi3798mv100_tsensor_ops = {
+	.get_temp = hi3798mv100_tsensor_get_temp,
+};
+
+static int hi3798mv100_tsensor_probe(struct platform_device *pdev)
+{
+	struct thermal_zone_device *tz;
+	void __iomem *base;
+
+	base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(base))
+		return PTR_ERR(base);
+
+	writel_relaxed(TSENSOR_ENABLE, base + TSENSOR_CTRL);
+
+	tz = devm_thermal_of_zone_register(&pdev->dev, 0, base, &hi3798mv100_tsensor_ops);
+	if (IS_ERR(tz))
+		return dev_err_probe(&pdev->dev, PTR_ERR(tz), "failed to register thermal zone\n");
+
+	devm_thermal_add_hwmon_sysfs(&pdev->dev, tz);
+	return 0;
+}
+
+static const struct of_device_id hi3798mv100_tsensor_of_match[] = {
+	{ .compatible = "hisilicon,hi3798mv100-tsensor" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, hi3798mv100_tsensor_of_match);
+
+static struct platform_driver hi3798mv100_tsensor_driver = {
+	.probe = hi3798mv100_tsensor_probe,
+	.driver = {
+		.name = "hi3798mv100-tsensor",
+		.of_match_table = hi3798mv100_tsensor_of_match,
+	},
+};
+module_platform_driver(hi3798mv100_tsensor_driver);
+
+MODULE_DESCRIPTION("Hi3798MV100 temperature sensor");
+MODULE_LICENSE("GPL");
diff --git a/drivers/cpufreq/hi3798mv100-cpufreq.c b/drivers/cpufreq/hi3798mv100-cpufreq.c
new file mode 100644
index 000000000..0ca04d8ad
--- /dev/null
+++ b/drivers/cpufreq/hi3798mv100-cpufreq.c
@@ -0,0 +1,94 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Hi3798MV100 CPU frequency switching via the CPU_LP mux (CRG + 0x48).
+ *
+ * The mux selects fixed PLL outputs (0 APLL, 1 800 MHz, 3 1.5 GHz, 4 24 MHz,
+ * 5 1.2 GHz, 6 400 MHz, 7 600 MHz); all four cores share it. Switch sequence
+ * as in U-Boot: write sel|0x300, then sel|0x700. Voltage stays as U-Boot's
+ * AVS set it. 400 MHz is deliberately absent (the vendor's 400 MHz dance broke
+ * femac RX). Registered as cooling device for the T-sensor thermal zone.
+ */
+#include <linux/cpufreq.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+
+#define CPU_LP_SEL_MASK		0x7
+
+static void __iomem *cpu_lp;
+
+static struct cpufreq_frequency_table hi3798mv100_freqs[] = {
+	{ .driver_data = 1, .frequency = 800000 },
+	{ .driver_data = 5, .frequency = 1200000 },
+	{ .frequency = CPUFREQ_TABLE_END },
+};
+
+static int hi3798mv100_cpufreq_target(struct cpufreq_policy *policy, unsigned int index)
+{
+	u32 sel = hi3798mv100_freqs[index].driver_data;
+
+	writel_relaxed(0x300 | sel, cpu_lp);
+	writel_relaxed(0x700 | sel, cpu_lp);
+	return 0;
+}
+
+static unsigned int hi3798mv100_cpufreq_get(unsigned int cpu)
+{
+	u32 sel = readl_relaxed(cpu_lp) & CPU_LP_SEL_MASK;
+	struct cpufreq_frequency_table *f;
+
+	cpufreq_for_each_entry(f, hi3798mv100_freqs)
+		if (f->driver_data == sel)
+			return f->frequency;
+	return 0;
+}
+
+static int hi3798mv100_cpufreq_init(struct cpufreq_policy *policy)
+{
+	cpufreq_generic_init(policy, hi3798mv100_freqs, 100 * NSEC_PER_USEC);
+	return 0;
+}
+
+static struct cpufreq_driver hi3798mv100_cpufreq_driver = {
+	.name		= "hi3798mv100",
+	.flags		= CPUFREQ_NEED_INITIAL_FREQ_CHECK | CPUFREQ_IS_COOLING_DEV,
+	.verify		= cpufreq_generic_frequency_table_verify,
+	.target_index	= hi3798mv100_cpufreq_target,
+	.get		= hi3798mv100_cpufreq_get,
+	.init		= hi3798mv100_cpufreq_init,
+	.attr		= cpufreq_generic_attr,
+};
+
+static int hi3798mv100_cpufreq_probe(struct platform_device *pdev)
+{
+	cpu_lp = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(cpu_lp))
+		return PTR_ERR(cpu_lp);
+
+	return cpufreq_register_driver(&hi3798mv100_cpufreq_driver);
+}
+
+static void hi3798mv100_cpufreq_remove(struct platform_device *pdev)
+{
+	cpufreq_unregister_driver(&hi3798mv100_cpufreq_driver);
+}
+
+static const struct of_device_id hi3798mv100_cpufreq_of_match[] = {
+	{ .compatible = "hisilicon,hi3798mv100-cpuctrl" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, hi3798mv100_cpufreq_of_match);
+
+static struct platform_driver hi3798mv100_cpufreq_platdrv = {
+	.probe = hi3798mv100_cpufreq_probe,
+	.remove_new = hi3798mv100_cpufreq_remove,
+	.driver = {
+		.name = "hi3798mv100-cpufreq",
+		.of_match_table = hi3798mv100_cpufreq_of_match,
+	},
+};
+module_platform_driver(hi3798mv100_cpufreq_platdrv);
+
+MODULE_DESCRIPTION("Hi3798MV100 CPU frequency driver");
+MODULE_LICENSE("GPL");
diff --git a/drivers/usb/host/xhci-hi3798mv100.c b/drivers/usb/host/xhci-hi3798mv100.c
new file mode 100644
index 000000000..c7c3d9c92
--- /dev/null
+++ b/drivers/usb/host/xhci-hi3798mv100.c
@@ -0,0 +1,131 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Hi3798MV100 USB3 (DWC3 core used as plain xHCI) bring-up glue.
+ *
+ * Replays the vendor 3.18 SDK clk-hiusb3.c enable sequence (CRG44 controller
+ * clocks/reset, CRG101 USB3 PHY resets, PERI_CTRL isolation, a few DWC3
+ * global registers), then populates the generic-xhci child node.
+ *
+ * reg: <xhci/dwc3 regs>, <CRG>, <PERI_CTRL>  (mapped without request: the
+ * child and other drivers own these ranges too).
+ */
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+
+#define PERI_CTRL		0x0008
+#define  USB3_IP_ISO_CTRL	BIT(26)
+#define PERI_CTRL_USB6		0x0138
+
+#define CRG44_USB3CTRL		0x00b0
+#define  USB3_VCC_SRST_REQ	BIT(12)
+#define  USB3_CLKS		(BIT(4) | BIT(2) | BIT(1) | BIT(0))
+#define CRG101_USB3PHY		0x0194
+#define  USB3_PHY_SRST_REQ	BIT(4)
+#define  USB3_PHY_SRST_TREQ	BIT(5)
+
+#define GTXTHRCFG		0xc108
+#define GRXTHRCFG		0xc10c
+#define GCTL			0xc110
+#define GUSB2PHYCFG0		0xc200
+#define  UTMI_8_16		BIT(3)
+#define  UTMI_ULPI		BIT(4)
+#define GUSB3PIPECTL0		0xc2c0
+#define  PIPE_SUSPHY		BIT(17)
+#define  PCS_SSP_SOFT_RESET	BIT(31)
+
+struct hi3798mv100_usb3 {
+	void __iomem *xhci, *crg, *peri;
+};
+
+static void __iomem *map_idx(struct platform_device *pdev, int i)
+{
+	struct resource *res = platform_get_resource(pdev, IORESOURCE_MEM, i);
+
+	if (!res)
+		return IOMEM_ERR_PTR(-EINVAL);
+	return devm_ioremap(&pdev->dev, res->start, resource_size(res)) ?: IOMEM_ERR_PTR(-ENOMEM);
+}
+
+static void rmw(void __iomem *a, u32 clr, u32 set)
+{
+	writel((readl(a) & ~clr) | set, a);
+}
+
+static void hi3798mv100_usb3_enable(struct hi3798mv100_usb3 *u)
+{
+	rmw(u->peri + PERI_CTRL, USB3_IP_ISO_CTRL, 0);
+
+	writel(0x431, u->crg + CRG101_USB3PHY);
+	writel(0x13ff, u->crg + CRG44_USB3CTRL);
+	mdelay(5);
+	rmw(u->crg + CRG44_USB3CTRL, USB3_VCC_SRST_REQ, 0);
+	mdelay(5);
+
+	rmw(u->xhci + GUSB3PIPECTL0, 0, PCS_SSP_SOFT_RESET);
+	rmw(u->xhci + GUSB2PHYCFG0, UTMI_ULPI | UTMI_8_16, 0);
+	mdelay(1);
+	rmw(u->xhci + GCTL, 0x3 << 12, 0x1 << 12);	/* host mode */
+
+	rmw(u->crg + CRG101_USB3PHY, USB3_PHY_SRST_REQ, 0);
+	mdelay(5);
+	rmw(u->crg + CRG101_USB3PHY, USB3_PHY_SRST_TREQ, 0);
+
+	rmw(u->xhci + GUSB3PIPECTL0, PIPE_SUSPHY | PCS_SSP_SOFT_RESET, 0);
+	mdelay(5);
+
+	writel(0x23100000, u->xhci + GTXTHRCFG);
+	writel(0x23100000, u->xhci + GRXTHRCFG);
+	mdelay(1);
+
+	writel(0x7381560d, u->peri + PERI_CTRL_USB6);	/* USB3 eye config */
+}
+
+static int hi3798mv100_usb3_probe(struct platform_device *pdev)
+{
+	struct hi3798mv100_usb3 *u;
+
+	u = devm_kzalloc(&pdev->dev, sizeof(*u), GFP_KERNEL);
+	if (!u)
+		return -ENOMEM;
+	u->xhci = map_idx(pdev, 0);
+	u->crg = map_idx(pdev, 1);
+	u->peri = map_idx(pdev, 2);
+	if (IS_ERR(u->xhci) || IS_ERR(u->crg) || IS_ERR(u->peri))
+		return -ENOMEM;
+
+	platform_set_drvdata(pdev, u);
+	hi3798mv100_usb3_enable(u);
+	dev_info(&pdev->dev, "USB3 up, GSNPSID %08x\n", readl(u->xhci + 0xc120));
+
+	return devm_of_platform_populate(&pdev->dev);
+}
+
+static void hi3798mv100_usb3_remove(struct platform_device *pdev)
+{
+	struct hi3798mv100_usb3 *u = platform_get_drvdata(pdev);
+
+	rmw(u->crg + CRG44_USB3CTRL, USB3_CLKS, 0);
+}
+
+static const struct of_device_id hi3798mv100_usb3_of_match[] = {
+	{ .compatible = "hisilicon,hi3798mv100-usb3" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, hi3798mv100_usb3_of_match);
+
+static struct platform_driver hi3798mv100_usb3_driver = {
+	.probe = hi3798mv100_usb3_probe,
+	.remove_new = hi3798mv100_usb3_remove,
+	.driver = {
+		.name = "hi3798mv100-usb3",
+		.of_match_table = hi3798mv100_usb3_of_match,
+	},
+};
+module_platform_driver(hi3798mv100_usb3_driver);
+
+MODULE_DESCRIPTION("Hi3798MV100 USB3 glue");
+MODULE_LICENSE("GPL");
diff --git a/drivers/soc/hisilicon/hi3798mv100-gpu.c b/drivers/soc/hisilicon/hi3798mv100-gpu.c
new file mode 100644
index 000000000..b3593fb8f
--- /dev/null
+++ b/drivers/soc/hisilicon/hi3798mv100-gpu.c
@@ -0,0 +1,186 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Hi3798MV100 Mali-450 MP2 bring-up glue.
+ *
+ * From the vendor SDK msp/drv/gpu/mali4xx/platform/mali450/mali4xx_clk.c:
+ * PERI_CRG53 (CRG + 0xd4): bit 0 GPU clock, bits 8..10 PP clocks, bit 4 GPU
+ * soft reset. U-Boot leaves 0x10 (in reset, clocks off). Enable the clocks,
+ * pulse the reset, then populate the lima child node.
+ *
+ * Also provides the GPU core clock (#clock-cells = <0>): CRG + 0x124 bits
+ * [2:0] select the rate, the switch is requested through PMC21 (+0x54):
+ * bit 18 = trend (1 up), bit 21 = request pulse. GPU voltage is the shared
+ * core rail, which the vendor driver never changes on this chip.
+ */
+#include <linux/clk-provider.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+
+#define CRG53_GPU		0x00d4
+#define  GPU_CKEN		BIT(0)
+#define  GPU_SRST		BIT(4)
+#define  GPU_PP_CKEN		(BIT(8) | BIT(9) | BIT(10))
+
+#define CRG_GPU_FREQ		0x0124
+#define  GPU_FREQ_SEL		GENMASK(2, 0)
+#define  GPU_DIV_CFG		GENMASK(5, 4)
+#define  GPU_DIV_CFG_BYPASS	BIT(8)
+#define  GPU_BEGIN_CFG_BYPASS	BIT(9)
+#define PMC18_POWER_TIME	0x0048
+#define PMC21_GPU_FREQ		0x0054
+#define  GPU_PWR_GOOD_WAIT	GENMASK(15, 0)
+#define  GPU_USE_PWR_GOOD_CPU	BIT(16)
+#define  GPU_FREQ_TREND_UP	BIT(18)
+#define  GPU_FREQ_FSM_EN	BIT(20)
+#define  GPU_FREQ_REQ		BIT(21)
+#define PMC44_GPU_CTRL		0x00b0
+#define  GPU_PMU_CNT_BYPASS	BIT(0)
+#define  GPU_PMU_BYPASS		BIT(1)
+
+/*
+ * Fixed GPU clock. Changing it while a job runs hangs the PP (lima devfreq
+ * does exactly that), and a hung GPU does not recover until reboot, so no
+ * devfreq: pick the rate at boot. 345.6 MHz = vendor default.
+ */
+static unsigned int mhz = 345;
+module_param(mhz, uint, 0444);
+MODULE_PARM_DESC(mhz, "GPU core clock in MHz (200/250/300/345/375/400/432)");
+
+/* vendor mali4xx_clk.c table for hi3798mv100 (500 MHz entry exceeds MAX_FREQ 432) */
+static const struct { unsigned long rate; u32 sel; } gpu_rates[] = {
+	{ 200000000, 6 }, { 250000000, 5 }, { 300000000, 4 }, { 345600000, 3 },
+	{ 375000000, 2 }, { 400000000, 1 }, { 432000000, 0 },
+};
+
+struct hi3798mv100_gpu {
+	struct clk_hw hw;
+	void __iomem *crg, *pmc;
+};
+#define to_gpu(_hw) container_of(_hw, struct hi3798mv100_gpu, hw)
+
+static unsigned long gpu_clk_recalc(struct clk_hw *hw, unsigned long parent)
+{
+	u32 sel = readl(to_gpu(hw)->crg + CRG_GPU_FREQ) & GPU_FREQ_SEL;
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(gpu_rates); i++)
+		if (gpu_rates[i].sel == sel)
+			return gpu_rates[i].rate;
+	return 500000000;	/* sel 7 */
+}
+
+static int gpu_clk_idx(unsigned long rate)
+{
+	int i;
+
+	for (i = ARRAY_SIZE(gpu_rates) - 1; i > 0; i--)
+		if (gpu_rates[i].rate <= rate)
+			break;
+	return i;
+}
+
+static long gpu_clk_round(struct clk_hw *hw, unsigned long rate, unsigned long *parent)
+{
+	return gpu_rates[gpu_clk_idx(rate)].rate;
+}
+
+static int gpu_clk_set(struct clk_hw *hw, unsigned long rate, unsigned long parent)
+{
+	struct hi3798mv100_gpu *g = to_gpu(hw);
+	int i = gpu_clk_idx(rate);
+	u32 ctl = readl(g->pmc + PMC21_GPU_FREQ);
+	u32 v;
+
+	if (gpu_rates[i].rate > gpu_clk_recalc(hw, 0))
+		ctl |= GPU_FREQ_TREND_UP;
+	else
+		ctl &= ~GPU_FREQ_TREND_UP;
+	writel(ctl, g->pmc + PMC21_GPU_FREQ);
+
+	v = readl(g->crg + CRG_GPU_FREQ) & ~GPU_FREQ_SEL;
+	writel(v | gpu_rates[i].sel, g->crg + CRG_GPU_FREQ);
+
+	writel(ctl | GPU_FREQ_REQ, g->pmc + PMC21_GPU_FREQ);
+	writel(ctl & ~GPU_FREQ_REQ, g->pmc + PMC21_GPU_FREQ);
+	return 0;
+}
+
+static const struct clk_ops gpu_clk_ops = {
+	.recalc_rate = gpu_clk_recalc,
+	.round_rate = gpu_clk_round,
+	.set_rate = gpu_clk_set,
+};
+
+static int hi3798mv100_gpu_probe(struct platform_device *pdev)
+{
+	struct resource *res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	struct resource *res_pmc = platform_get_resource(pdev, IORESOURCE_MEM, 1);
+	struct clk_init_data init = { .name = "gpu_core", .ops = &gpu_clk_ops };
+	struct hi3798mv100_gpu *g;
+	void __iomem *crg;
+	u32 v;
+	int ret;
+
+	g = devm_kzalloc(&pdev->dev, sizeof(*g), GFP_KERNEL);
+	if (!g)
+		return -ENOMEM;
+	if (!res || !res_pmc)
+		return -EINVAL;
+	crg = devm_ioremap(&pdev->dev, res->start, resource_size(res));
+	g->pmc = devm_ioremap(&pdev->dev, res_pmc->start, resource_size(res_pmc));
+	if (!crg || !g->pmc)
+		return -ENOMEM;
+	g->crg = crg;
+
+	v = readl(crg + CRG53_GPU) | GPU_CKEN | GPU_PP_CKEN;
+	writel(v | GPU_SRST, crg + CRG53_GPU);
+	udelay(10);
+	writel(v & ~GPU_SRST, crg + CRG53_GPU);
+	udelay(10);
+	/* vendor hisi_pmc_setparameter(): Mali PMU + power-good counter, HW freq FSM */
+	writel(readl(g->pmc + PMC44_GPU_CTRL) & ~(GPU_PMU_BYPASS | GPU_PMU_CNT_BYPASS),
+	       g->pmc + PMC44_GPU_CTRL);
+	v = readl(g->pmc + PMC21_GPU_FREQ);
+	v = (v | GPU_FREQ_FSM_EN) & ~(GPU_PWR_GOOD_WAIT | GPU_USE_PWR_GOOD_CPU);
+	writel(v | 0x2fff, g->pmc + PMC21_GPU_FREQ);
+	writel(0x00ffff88, g->pmc + PMC18_POWER_TIME);
+	v = readl(crg + CRG_GPU_FREQ);
+	v &= ~(GPU_BEGIN_CFG_BYPASS | GPU_DIV_CFG_BYPASS | GPU_DIV_CFG);
+	writel(v | GPU_FREQ_SEL, crg + CRG_GPU_FREQ);
+	gpu_clk_set(&g->hw, mhz == 345 ? 345600000UL : mhz * 1000000UL, 0);
+
+	g->hw.init = &init;
+	ret = devm_clk_hw_register(&pdev->dev, &g->hw);
+	if (ret)
+		return ret;
+	ret = devm_of_clk_add_hw_provider(&pdev->dev, of_clk_hw_simple_get, &g->hw);
+	if (ret)
+		return ret;
+
+	dev_info(&pdev->dev, "GPU clocks on, CRG53 %08x, core %lu Hz\n",
+		 readl(crg + CRG53_GPU), gpu_clk_recalc(&g->hw, 0));
+
+	return devm_of_platform_populate(&pdev->dev);
+}
+
+static const struct of_device_id hi3798mv100_gpu_of_match[] = {
+	{ .compatible = "hisilicon,hi3798mv100-gpu-glue" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, hi3798mv100_gpu_of_match);
+
+static struct platform_driver hi3798mv100_gpu_driver = {
+	.probe = hi3798mv100_gpu_probe,
+	.driver = {
+		.name = "hi3798mv100-gpu",
+		.of_match_table = hi3798mv100_gpu_of_match,
+	},
+};
+module_platform_driver(hi3798mv100_gpu_driver);
+
+MODULE_DESCRIPTION("Hi3798MV100 GPU glue");
+MODULE_LICENSE("GPL");
